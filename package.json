{
  "name": "my-farms-platform",
  "version": "1.2.0",
  "description": "My Farms end-to-end e-commerce platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client:dev": "vite --config client/vite.config.js",
    "build:client": "vite build --config client/vite.config.js",
    "android:add": "npm run build:client && cap add android",
    "android:sync": "npm run build:client && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:bundle:release": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "@capacitor/core": "^8.4.1",
    "mongoose": "^8.11.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@vitejs/plugin-react": "^4.4.0",
    "nodemon": "^3.1.10",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  }
}
